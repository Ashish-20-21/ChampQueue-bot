# ChampQueue-bot — environment template.
# Copy to .env and fill in real values. NEVER commit .env.
# Every value below is a placeholder. IDs are Discord snowflakes
# (Developer Mode → right-click → Copy ID). Lines marked "optional" can be blank.

# ─── Required: the bot will not start without these ───────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token
GUILD_ID=your_server_id
# Comma-separated role IDs with full admin power (note the plural).
ADMIN_ROLE_IDS=admin_role_id_1,admin_role_id_2
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key: bypasses row-level security. Treat it as the most valuable secret.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ─── Roles (optional) ─────────────────────────────────────────────────────────
# HOD: higher-trust role; confirms paid shield grants (second person of the two-person rule).
HOD_ROLE_IDS=hod_role_id_1,hod_role_id_2
# Moderators: shared-workload role (queue clean/replace, match review/scrap/map-change,
# panels, capped MMR fixes). Keep it separate from ADMIN_ROLE_IDS.
MODERATOR_ROLE_IDS=moderator_role_id

# ─── Match channels ───────────────────────────────────────────────────────────
# Permanent match log (room code + roster)
MATCH_LOG_CHANNEL_ID=channel_id
# Result uploads
RESULT_UPLOAD_CHANNEL_ID=channel_id
# Verification cards (host approves here)
RESULT_APPROVAL_CHANNEL_ID=channel_id
# Review queue
ISSUE_INTAKE_CHANNEL_ID=channel_id
# Resolution notices
ISSUE_RESOLVED_CHANNEL_ID=channel_id
# IGN-change notices
IGN_CHANGE_CHANNEL_ID=channel_id
# /afk reports
AFK_CHANNEL_ID=channel_id
# /report reports (falls back to AFK_CHANNEL_ID)
REPORT_CHANNEL_ID=channel_id
# Incident log (#botlog)
BOTLOG_CHANNEL_ID=channel_id
# Optional: re-post every submitted scoreboard here as an image (blank = off).
RESULT_SS_CHANNEL_ID=
# Optional: one short "result submitted" line per match (blank = off).
MATCH_STATUS_CHANNEL_ID=
# Optional: daily automated digest at 12:00 UTC (blank = off).
DIGEST_CHANNEL_ID=

# ─── Season channels ──────────────────────────────────────────────────────────
HALL_OF_FAME_CHANNEL_ID=channel_id
POINTS_LEADERBOARD_CHANNEL_ID=channel_id
SHIELD_CHANNEL_ID=channel_id
HOD_APPROVAL_CHANNEL_ID=channel_id

# ─── Vision AI for scoreboard reading ─────────────────────────────────────────
# Providers in the code: openai | anthropic | nvidia_nim | qwen
VISION_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_VISION_MODEL=gpt-5.4-mini
# Alternates (uncomment the pair you use):
# ANTHROPIC_API_KEY=your_anthropic_api_key
# NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key
# NVIDIA_NIM_BASE_URL=
# QWEN_API_KEY=your_qwen_api_key

# ─── Feature switches (true/false; restart to apply) ──────────────────────────
# Per-team private voice channels
CREATE_MATCH_VOICE_CHANNELS=false
# Save operator-skill picks to the database
STORE_SKILL_VOTES=true
# "+result" text upload
RESULT_TEXT_TRIGGER=true
# /match-submit upload (turning both uploads off is refused)
RESULT_SLASH_COMMAND=true
# One timing log line per click (zero cost when false)
INTERACTION_TIMING=true

# ─── Limits ───────────────────────────────────────────────────────────────────
# /host-replace-player uses per match for hosts (0 = feature off)
HOST_REPLACE_LIMIT=2
