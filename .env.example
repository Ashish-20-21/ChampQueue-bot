# Copy this file to .env and fill in real values. Never commit .env.

DISCORD_BOT_TOKEN=DiscordbotToken
GUILD_ID=15284750...
# Unified 2026-07-29: was ADMIN_ROLE_ID (singular). HOD + admin team all
# get identical full admin power now — comma-separated, no spaces needed
# around commas (whitespace is stripped). Example with just one role:
# ADMIN_ROLE_IDS=15284750...
ADMIN_ROLE_IDS=15284750...,15284750...
#APPROVED_ROLE_ID =15284750...
AFK_CHANNEL_ID=15284750...
MATCH_LOG_CHANNEL_ID=15284750...
# Unified 2026-07-29: server moved to one show, four ticket-counter
# queues — everything downstream of "a match happened" is now ONE pool.
# These replace the old RESULT_*_CHANNEL_ID_EAST/WEST pairs entirely.
RESULT_UPLOAD_CHANNEL_ID=15284750...
RESULT_APPROVAL_CHANNEL_ID=15284750...
ISSUE_INTAKE_CHANNEL_ID=15284750...
ISSUE_RESOLVED_CHANNEL_ID=15284750...
IGN_CHANGE_CHANNEL_ID=15284750...

SUPABASE_URL=https://supabse_project.supabase.co
SUPABASE_SERVICE_KEY=your key
# Vision AI provider for scoreboard extraction: anthropic | openai | qwen
VISION_PROVIDER=openai
OPENAI_API_KEY=Use your own OpenAI API key here
OPENAI_VISION_MODEL=gpt-5.4-mini
#VISION_PROVIDER=nvidia_nim
#NVIDIA_NIM_API_KEY=nvap
#NVIDIA_NIM_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# QWEN_API_KEY=

# Optional: channel for the daily automated digest post. Leave blank to disable.
DIGEST_CHANNEL_ID=